{
  "name": "media-studio",
  "version": "1.0.0",
  "private": true,
  "description": "A local-only FFmpeg media studio for trimming, MP4 conversion, and MP3 extraction.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "npm run typecheck",
    "start": "node --experimental-strip-types src/server.ts",
    "dev": "node --experimental-strip-types src/server.ts",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.browser.json"
  },
  "devDependencies": {
    "@types/node": "26.5.1",
    "typescript": "7.0.2"
  }
}
